# Behövs för att köra sajten (npm run dev)
#
# Läsningen sker med den publika nyckeln. RLS släpper igenom select och
# blockerar all skrivning, så nyckeln är inte känslig — den ligger ändå i
# webbläsaren.
NEXT_PUBLIC_SUPABASE_URL=https://ditt-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din_publika_nyckel

# Behövs bara för ETL-skripten i scripts/etl/, som skriver till databasen.
#
# SUPABASE_SECRET_KEY är det aktuella namnet. Skripten faller tillbaka på
# SUPABASE_SERVICE_ROLE_KEY om det förstnämnda saknas, och sajten faller
# tillbaka på SUPABASE_PUBLISHABLE_KEY om NEXT_PUBLIC_SUPABASE_ANON_KEY
# saknas — båda paren fungerar alltså, men de nya namnen är de som gäller.
#
# Denna går förbi RLS och har full skrivrätt. Den ska aldrig committas och
# aldrig hamna i något som skickas till webbläsaren.
SUPABASE_SECRET_KEY=din_hemliga_nyckel

# Alternativ till NEXT_PUBLIC_SUPABASE_URL för ETL-skripten — de bygger URL:en
# ur projekt-referensen om URL:en inte är satt.
SUPABASE_PROJECT_REF=ditt_projekt_ref

# Behövs bara för lager 2 och 3, alltså klarspråksförklaringarna. De är körda
# en gång och sparade i databasen; sajten anropar aldrig OpenAI.
OPENAI_API_KEY=sk-proj-din_nyckel

# Modellval för batchskripten. Har defaults i koden och behöver sällan sättas.
# LAGER2_MODELL=gpt-5.6-luna
# LAGER3_MODELL=gpt-5.6-terra

# Sajtens publika adress, utan avslutande snedstreck. Används för metadataBase,
# delningsbilderna och sitemap — alla tre kräver absoluta URL:er.
#
# Sätts den inte används Vercels egen VERCEL_PROJECT_PRODUCTION_URL, och först
# därefter http://localhost:3000. Sätt den här när sajten får ett eget
# domännamn; utan den pekar delningsbilderna på vercel.app-adressen.
NEXT_PUBLIC_SITE_URL=https://example.com

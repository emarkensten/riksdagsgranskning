NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Sajtens publika adress, utan avslutande snedstreck. Används för metadataBase,
# delningsbilderna och sitemap — alla tre kräver absoluta URL:er.
#
# Sätts den inte används Vercels egen VERCEL_PROJECT_PRODUCTION_URL, och först
# därefter http://localhost:3000. Sätt den här när sajten får ett eget
# domännamn; utan den pekar delningsbilderna på vercel.app-adressen.
NEXT_PUBLIC_SITE_URL=https://example.com
